---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { club } from '../data/club.js';
import { core, sections, groups } from '../data/teachers.js';
import { advisors, president, officerGroups } from '../data/officers.js';
---
<Layout title="關於我們">
  <section class="page">
    <PageHero eyebrow="關 於 樂 團" title="關於我們" />

    <section class="card about-intro">
      <h2 class="card-title">樂團簡介</h2>
      <p class="intro-text">{club.intro}</p>
      <div class="chips">{club.features.map((f) => <span class="chip">{f}</span>)}</div>
      <p class="faint ensemble">{club.ensemble}</p>
    </section>

    <a class="card intro-entry" href="/intro">
      <img src="/intro/thumb-01.jpg" alt="集美國小國樂團介紹電子書封面" loading="lazy" />
      <div class="intro-entry-text">
        <strong>翻閱樂團介紹 →</strong>
        <p class="muted">23 頁的國樂團介紹電子書，可翻頁、放大、全螢幕閱讀。</p>
      </div>
    </a>

    <h2 class="sec-head"><span class="sec-dot brand"></span>核心團隊</h2>
    <div class="grid cols-3">
      {core.map((p) => (
        <article class="card team-card">
          <div class="team-head">
            {p.photo && <img class="team-photo" src={p.photo} alt={`${p.name}照片`} width="72" height="72" loading="lazy" />}
            <div>
              <p class="label">{p.role}</p>
              <strong class="team-name">{p.name}</strong>
            </div>
          </div>
          <p class="muted team-desc">{p.desc}</p>
        </article>
      ))}
    </div>

    <h2 class="sec-head"><span class="sec-dot gold"></span>各分部師資</h2>
    <div class="grid cols-2">
      {sections.map((s) => (
        <article class="card part">
          <div class="part-name">{s.part}</div>
          <div>
            <strong>{s.teacher}</strong>
            {s.note && <p class="faint">{s.note}</p>}
          </div>
        </article>
      ))}
    </div>

    <h2 class="sec-head"><span class="sec-dot seal"></span>國樂三團（階梯式）</h2>
    <div class="grid cols-3">
      {groups.map((g) => (
        <article class="card group-card">
          <p class="label">{g.tier}</p>
          <strong class="group-name">{g.name}</strong>
          <p class="group-teacher">任課：{g.teacher}</p>
          <p class="muted group-focus">{g.focus}</p>
        </article>
      ))}
    </div>

    <h2 class="sec-head"><span class="sec-dot brand"></span>後援會幹部</h2>
    <article class="card officer-card officer-advisors">
      <p class="label">{advisors.role}</p>
      <strong class="team-name">{advisors.names.join('、')}</strong>
    </article>
    <article class="card officer-card officer-president">
      <p class="label">{president.role}</p>
      <strong class="team-name">{president.name}</strong>
    </article>
    <div class="officer-stub" aria-hidden="true"></div>
    <p class="officer-caption">副會長群（兼任各組組長）</p>
    <div class="grid cols-3">
      {officerGroups.map((g) => (
        <article class={`card officer-card${g.recruiting ? ' recruiting' : ''}`}>
          <p class="officer-group">{g.group}</p>
          <strong class={`team-name${g.recruiting ? ' recruit-name' : ''}`}>
            {g.recruiting ? '熱情招募中' : g.names.join('、')}
          </strong>
        </article>
      ))}
    </div>
  </section>
</Layout>
<style>
  .about-intro{padding:26px 28px;box-shadow:0 6px 20px -12px rgba(120,90,40,.45)}
  .card-title{font-family:"Noto Serif TC",serif;font-weight:700;font-size:20px;color:var(--ink);margin:0 0 12px}
  .intro-text{margin:0 0 14px;font-size:15px;color:var(--muted);line-height:1.85}
  .chips{display:flex;flex-wrap:wrap;gap:9px;margin:0 0 14px}
  .chip{background:var(--chip);color:var(--brand);font-size:13px;font-weight:600;padding:7px 14px;border-radius:999px}
  .ensemble{margin:0;font-size:13.5px}

  .intro-entry{display:flex;gap:18px;align-items:center;text-decoration:none;color:inherit;margin-top:16px;padding:16px 18px;border:1px solid var(--line-soft);transition:transform .15s,box-shadow .15s}
  .intro-entry:hover{transform:translateY(-2px);box-shadow:0 8px 22px -12px rgba(120,90,40,.5)}
  .intro-entry img{width:120px;height:auto;border-radius:10px;border:1px solid var(--line);flex:none;display:block}
  .intro-entry-text strong{font-family:"Noto Serif TC",serif;color:var(--brand);font-size:17px}
  .intro-entry-text p{margin:6px 0 0;font-size:13.5px;line-height:1.7}

  .team-card{padding:20px 22px}
  .team-head{display:flex;align-items:center;gap:14px}
  .team-head .label{margin:0 0 3px}
  .team-photo{width:72px;height:72px;border-radius:50%;object-fit:cover;flex:none;border:2.5px solid #fff;box-shadow:0 0 0 1.5px var(--gold),0 6px 14px -8px rgba(120,90,40,.55);background:var(--chip)}
  .team-name{font-family:"Noto Serif TC",serif;color:var(--ink);font-size:17px}
  .team-desc{margin:10px 0 0;font-size:13.5px;line-height:1.7}

  .part{display:flex;gap:14px;align-items:center;padding:14px 18px;border-radius:14px;box-shadow:0 4px 14px -10px rgba(120,90,40,.4)}
  .part-name{background:var(--brand);color:#fff;font-weight:700;border-radius:9px;padding:8px 10px;flex:none;min-width:84px;text-align:center;font-size:14px;font-family:"Noto Serif TC",serif}
  .part strong{color:var(--ink);font-size:15px}
  .part p{margin:2px 0 0;font-size:12.5px}

  .group-card{padding:20px 22px;border-top:4px solid var(--brand)}
  .group-name{font-family:"Noto Serif TC",serif;color:var(--ink);font-size:18px}
  .group-teacher{margin:6px 0 8px;font-size:12.5px;color:var(--brand);font-weight:600}
  .group-focus{margin:0;font-size:13.5px;line-height:1.7}

  .officer-card{padding:20px 22px;text-align:center}
  .officer-advisors{max-width:230px;margin:0 auto 14px}
  .officer-president{max-width:230px;margin:0 auto}
  .officer-stub{width:2px;height:18px;background:var(--line);margin:0 auto}
  .officer-caption{text-align:center;font-size:13.5px;color:var(--muted);margin:8px 0 14px}
  .officer-group{display:table;background:var(--chip);color:var(--brand);font-size:12.5px;font-weight:700;padding:4px 14px;border-radius:999px;margin:0 auto 10px}
  .recruiting{box-shadow:none;background:transparent;border:1.5px dashed var(--faint)}
  .recruit-name{color:var(--faint);font-size:15px}

  @media(max-width:480px){.intro-entry{flex-direction:column;align-items:flex-start}.intro-entry img{width:100%}}
</style>
