---
import Layout from '../layouts/Layout.astro';
import { club } from '../data/club.js';
import { core, sections, groups } from '../data/teachers.js';
import { officers } from '../data/officers.js';
---
<Layout title="關於我們">
  <h1>關於我們</h1>

  <section class="card">
    <h2>社團簡介</h2>
    <p>{club.intro}</p>
    <ul>{club.features.map((f) => <li>{f}</li>)}</ul>
    <p class="muted">{club.ensemble}</p>
  </section>

  <h2 style="margin-top:2rem">核心團隊</h2>
  <div class="grid cols-3">
    {core.map((p) => (
      <article class="card">
        <p class="label">{p.role}</p>
        <strong>{p.name}</strong>
        <p class="muted">{p.desc}</p>
      </article>
    ))}
  </div>

  <h2 style="margin-top:2rem">各分部師資</h2>
  <div class="grid cols-2">
    {sections.map((s) => (
      <article class="card part">
        <div class="part-name">{s.part}</div>
        <div>
          <strong>{s.teacher}</strong>
          {s.note && <p class="muted">{s.note}</p>}
        </div>
      </article>
    ))}
  </div>

  <h2 style="margin-top:2rem">國樂三團（階梯式）</h2>
  <div class="grid cols-3">
    {groups.map((g) => (
      <article class="card">
        <p class="label">{g.tier}</p>
        <strong>{g.name}</strong>
        <p class="muted">任課：{g.teacher}</p>
        <p>{g.focus}</p>
      </article>
    ))}
  </div>

  <h2 style="margin-top:2rem">家長幹部</h2>
  <div class="grid cols-3">
    {officers.map((o) => (
      <article class="card">
        <p class="label">{o.role}</p>
        <strong>{o.name}</strong>
        {o.note && <p class="muted">{o.note}</p>}
      </article>
    ))}
  </div>
</Layout>
<style>
  .part{display:flex;gap:.9rem;align-items:center}
  .part-name{background:var(--brand);color:#fff;font-weight:700;border-radius:8px;padding:.3rem .7rem;flex-shrink:0;min-width:5.5rem;text-align:center}
  .part p{margin:.15rem 0 0}
  section.card ul{margin:.4rem 0 .4rem 1.25rem}
</style>
