---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { summer } from '../data/summer.js';
const embedUrl = (a) => {
  if (a.driveId) return `https://drive.google.com/file/d/${a.driveId}/preview`;
  const base = `https://www.youtube-nocookie.com/embed/${a.videoId}?rel=0`;
  return a.start ? `${base}&start=${a.start}` : base;
};
---
<Layout title="暑訓專區" description="集美國小國樂團暑期練習作業與示範影片。">
  <section class="page">
    <PageHero eyebrow="暑 ・ 期 ・ 練 ・ 功" title="暑訓專區" sub={summer.intro} />

    <h2 class="sec-head first"><span class="sec-dot brand"></span>暑訓行事曆</h2>
    {summer.scheduleNote && <p class="sec-note">{summer.scheduleNote}</p>}
    <a class="card schedule" href="/summer-schedule.jpg" target="_blank" rel="noopener noreferrer">
      <img src="/summer-schedule.jpg" alt="集美國樂團 7～8 月暑訓行事曆，含各分部練習時間與錄影功課繳交期限" width="1706" height="960" loading="lazy" />
      <span class="schedule-hint">點圖可放大 ↗</span>
    </a>

    <h2 class="sec-head"><span class="sec-dot gold"></span>暑訓教室</h2>
    {summer.classrooms && (
      <>
        {summer.classrooms.title && <p class="sec-note">{summer.classrooms.title}</p>}
        <section class="card classroom">
          <div class="classroom-scroll">
            <table class="classroom-table">
              <thead>
                <tr><th>分部</th><th>教室</th><th>老師</th></tr>
              </thead>
              <tbody>
                {summer.classrooms.rows.map((r) => (
                  <tr>
                    <td class="cr-part">{r.part}{r.time && <span class="cr-time">{r.time}</span>}</td>
                    <td>{r.room}</td>
                    <td>{r.teacher}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {summer.classrooms.notes.length > 0 && (
            <ul class="classroom-notes">
              {summer.classrooms.notes.map((n) => <li>{n}</li>)}
            </ul>
          )}
        </section>
      </>
    )}

    <h2 class="sec-head"><span class="sec-dot seal"></span>練習作業</h2>
    {summer.assignmentsNote && <p class="sec-note">{summer.assignmentsNote}</p>}
    {summer.assignments.length ? (
      <div class="grid">
        {summer.assignments.map((a) => (
          <article class="card assign">
            <div class="assign-text">
              <div class="assign-head">
                <strong class="assign-title">{a.title}</strong>
                {a.badge && <span class={`assign-badge${a.badge.startsWith('考核') ? ' exam' : ''}`}>{a.badge}</span>}
              </div>
              <p class="assign-detail">{a.detail}</p>
              {a.tip && <p class="assign-tip">💡 {a.tip}</p>}
            </div>
            <div class="video-embed">
              <iframe
                src={embedUrl(a)}
                title={`${a.title} 示範影片`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="muted">暑訓作業準備中，敬請期待。</p>
    )}

    <section class="card upload-note">
      <strong>作業繳交</strong>
      {summer.uploadFormUrl ? (
        <>
          <p class="muted">請於各曲目期限前，透過下方表單上傳你的演奏影片（上傳時需登入 Google 帳號）。</p>
          <a class="btn" href={summer.uploadFormUrl} target="_blank" rel="noopener noreferrer">前往作業上傳表單</a>
        </>
      ) : (
        <p class="muted">「暑訓作業上傳表單」建置中，網址產生後會在此公布並通知大家，請先把握時間練習。</p>
      )}
    </section>
  </section>
</Layout>
<style>
  .sec-note{white-space:pre-line;margin:0 0 14px;font-size:14.5px;color:var(--muted);line-height:1.9;max-width:680px}

  .schedule{display:block;padding:12px;text-align:right;transition:transform .15s,box-shadow .15s}
  .schedule:hover{transform:translateY(-2px);box-shadow:0 8px 22px -12px rgba(120,90,40,.5)}
  .schedule img{display:block;width:100%;height:auto;border-radius:10px;border:1px solid var(--line)}
  .schedule-hint{display:inline-block;margin-top:8px;font-size:12.5px;color:var(--faint);font-weight:600}

  .classroom{padding:18px 20px}
  .classroom-scroll{overflow-x:auto}
  .classroom-table{width:100%;border-collapse:collapse;font-size:14.5px}
  .classroom-table th,.classroom-table td{padding:11px 14px;text-align:left;vertical-align:middle;white-space:nowrap}
  .classroom-table thead th{background:var(--brand);color:#fff;font-family:"Noto Serif TC",serif;font-weight:700;font-size:14px}
  .classroom-table thead th:first-child{border-top-left-radius:10px}
  .classroom-table thead th:last-child{border-top-right-radius:10px}
  .classroom-table tbody tr:nth-child(even){background:rgba(120,90,40,.045)}
  .classroom-table tbody td{border-bottom:1px solid var(--line-soft);color:var(--muted)}
  .classroom-table tbody tr:last-child td{border-bottom:0}
  .classroom-table .cr-part{font-weight:600;color:var(--ink)}
  .classroom-table .cr-time{display:block;margin-top:2px;font-size:12px;font-weight:400;color:var(--faint)}
  .classroom-notes{margin:14px 2px 0;padding-left:18px;display:flex;flex-direction:column;gap:7px}
  .classroom-notes li{font-size:13px;color:var(--muted);line-height:1.7}
  @media(max-width:480px){
    .classroom{padding:14px 12px}
    .classroom-table{font-size:14px}
    .classroom-table th,.classroom-table td{padding:10px 9px}
  }

  .assign{padding:20px 22px;border-top:4px solid var(--brand)}
  .assign-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .assign-title{font-family:"Noto Serif TC",serif;color:var(--ink);font-size:18px}
  .assign-badge{flex:none;background:var(--chip);color:var(--brand);font-size:12.5px;font-weight:700;padding:5px 12px;border-radius:999px}
  .assign-badge.exam{background:#FBEEEC;color:var(--seal)}
  .assign-detail{margin:12px 0 0;font-size:14.5px;color:var(--muted);line-height:1.85}
  .assign-tip{margin:8px 0 0;font-size:13px;color:var(--seal);line-height:1.7}

  .video-embed{position:relative;margin-top:14px;border-radius:12px;overflow:hidden;aspect-ratio:16/9;background:#000;border:1px solid var(--line)}
  .video-embed iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block}

  /* 寬螢幕：作業卡改左文右影，說明與影片同一視野、頁面長度減半；手機維持上下堆疊。
     文字包成單一 .assign-text 區塊自然流動——若讓各行各佔一 grid 列，影片撐高會把列距拉開、卡片間空行不一致 */
  @media(min-width:860px){
    .assign{display:grid;grid-template-columns:minmax(0,1fr) 400px;column-gap:28px;align-items:center}
    .video-embed{margin-top:0}
  }

  .upload-note{margin-top:16px;padding:20px 22px}
  .upload-note strong{display:block;font-family:"Noto Serif TC",serif;color:var(--ink);font-size:16px;margin-bottom:8px}
  .upload-note .btn{margin-top:14px}
</style>
