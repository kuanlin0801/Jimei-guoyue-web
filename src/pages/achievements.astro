---
import Layout from '../layouts/Layout.astro';
import { achievements } from '../data/achievements.js';
---
<Layout title="成果與榮譽">
  <h1>成果與榮譽</h1>
  <p class="muted">歷年比賽得獎與重要演出紀錄。</p>
  {achievements.length === 0 && <p class="muted">尚未有紀錄。</p>}
  <ol class="timeline">
    {achievements.map((a) => (
      <li class="card ach">
        <span class="ach-year">{a.year}</span>
        <div>
          <strong>{a.title}</strong>
          {a.detail && <p class="muted">{a.detail}</p>}
        </div>
      </li>
    ))}
  </ol>
</Layout>
<style>
  .timeline{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.75rem}
  .ach{display:flex;gap:1rem;align-items:flex-start}
  .ach-year{background:var(--vermilion);color:#fff;font-weight:700;border-radius:8px;padding:.25rem .6rem;flex-shrink:0}
  .ach p{margin:.15rem 0 0}
</style>
