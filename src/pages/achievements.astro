---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { performances, teamAwards, soloAwardGroups } from '../data/achievements.js';

// 統計數字直接由資料推導，幹部加列即自動更新
const soloCount = soloAwardGroups.reduce((n, g) => n + g.awards.length, 0);

// 演出依年份分組（date 為 YYYY/MM/DD；「歷年」等非日期字串自成一組）
const perfGroups = [];
for (const p of performances) {
  const dated = p.date.includes('/');
  const year = dated ? p.date.slice(0, 4) : p.date;
  const md = dated ? p.date.slice(5) : '';
  const g = perfGroups.find((x) => x.year === year);
  if (g) g.items.push({ ...p, md });
  else perfGroups.push({ year, items: [{ ...p, md }] });
}
---
<Layout title="成果與榮譽">
  <section class="page">
    <PageHero eyebrow="榮 耀 時 刻" title="成果與榮譽" sub="集美國小國樂團歷年競賽榮譽與公開演出紀錄。" />

    <ul class="ach-stats">
      <li><span class="num">{teamAwards.length}</span><span class="lbl">團體獎</span></li>
      <li><span class="num">{soloCount}</span><span class="lbl">個人獎</span></li>
      <li><span class="num">{performances.length}+</span><span class="lbl">場公開演出</span></li>
    </ul>

    <section class="ach-block">
      <h2 class="ach-h2 first">競賽榮譽</h2>

      <h3 class="ach-sub">樂團團體獎</h3>
      <div class="team-grid">
        {teamAwards.map((a) => (
          <article class={`card team-award tier-${a.tier}`}>
            <span class={`badge ${a.tier}`}>{a.result}</span>
            <strong class="ta-comp">{a.competition}</strong>
            <span class="ta-meta faint">{a.year}｜{a.item}</span>
          </article>
        ))}
      </div>

      <h3 class="ach-sub">個人獎</h3>
      <div class="solo-grid">
        {soloAwardGroups.map((g) => (
          <article class="card solo-card">
            <h4 class="solo-title">{g.group}</h4>
            <ul class="solo-list">
              {g.awards.map((a) => (
                <li class="solo-row">
                  <span class={`badge ${a.tier}`}>{a.result}</span>
                  <span class="solo-body">
                    <strong>{a.name}</strong>
                    <span class="solo-item">{a.item}{a.note ? `・${a.note}` : ''}</span>
                  </span>
                  <span class="solo-year faint">{a.year}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="ach-block">
      <h2 class="ach-h2">演出紀錄</h2>
      <div class="perf-grid">
        {perfGroups.map((g) => (
          <article class="card perf-card">
            <h3 class="perf-year">{g.year === '歷年' ? '歷年' : `${g.year} 年`}</h3>
            <ul class="perf-list">
              {g.items.map((p) => (
                <li class="perf-row">
                  <span class="perf-date">{p.md}</span>
                  <span class="perf-body">
                    <strong>{p.title}</strong>
                    {p.venue && <span class="perf-venue faint">{p.venue}{p.note ? `・${p.note}` : ''}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </section>
</Layout>
<style>
  /* 統計列：數字由資料推導 */
  .ach-stats{list-style:none;display:flex;flex-wrap:wrap;gap:10px 34px;padding:0;margin:0 0 8px}
  .ach-stats li{display:flex;align-items:baseline;gap:9px}
  .ach-stats li::before{content:"";width:8px;height:8px;border-radius:50%;align-self:center;flex:none}
  .ach-stats li:nth-child(1)::before{background:var(--brand)}
  .ach-stats li:nth-child(2)::before{background:var(--gold)}
  .ach-stats li:nth-child(3)::before{background:var(--seal)}
  .ach-stats .num{font-family:"Noto Serif TC",serif;font-weight:900;font-size:26px;color:var(--ink);line-height:1}
  .ach-stats .lbl{font-size:13.5px;color:var(--muted)}

  .ach-h2{font-family:"Noto Serif TC",serif;font-weight:700;font-size:21px;color:#4a3f2a;padding-bottom:9px;border-bottom:2px solid var(--line);margin:34px 0 4px}
  .ach-h2.first{margin-top:18px}
  .ach-sub{font-family:"Noto Sans TC",system-ui,sans-serif;font-weight:700;font-size:15px;color:var(--brand-dark);margin:18px 0 10px}

  .badge{display:inline-flex;align-items:center;justify-content:center;min-width:58px;
    padding:5px 11px;border-radius:999px;font-weight:700;font-size:12.5px;line-height:1.2;text-align:center;white-space:nowrap}
  .badge.gold{background:var(--gold);color:#3a2c08}
  .badge.silver{background:#C9CDD4;color:#2f3338}
  .badge.bronze{background:#D49A63;color:#3a2407}
  .badge.normal{background:#f3ead8;border:1px solid #e3d4b8;color:#8a7c5e}

  /* 團體獎：三張展示卡並排，上緣色條依獎項層級 */
  .team-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
  .team-award{display:flex;flex-direction:column;align-items:center;text-align:center;gap:9px;padding:20px 18px;border-top:4px solid var(--line)}
  .team-award.tier-gold{border-top-color:var(--gold)}
  .ta-comp{font-family:"Noto Serif TC",serif;color:var(--ink);font-size:16.5px}
  .ta-meta{font-size:12.5px}

  /* 個人獎：一賽事一卡、桌機三欄並排；卡窄故列採「badge 左、年份右、人名曲目下一行」堆疊式 */
  .solo-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:14px;align-items:start}
  .solo-card{padding:18px 20px}
  .solo-title{font-family:"Noto Sans TC",system-ui,sans-serif;font-weight:700;font-size:14px;color:var(--ink);margin:0 0 6px;display:flex;align-items:center;gap:8px}
  .solo-title::before{content:"";width:7px;height:15px;background:var(--brand);border-radius:2px;display:inline-block}
  .solo-list{list-style:none;margin:0;padding:0}
  .solo-row{display:grid;grid-template-columns:auto 1fr;gap:5px 10px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line-soft)}
  .solo-row:last-child{border-bottom:0;padding-bottom:2px}
  .solo-row .badge{grid-column:1;grid-row:1;justify-self:start}
  .solo-year{grid-column:2;grid-row:1;justify-self:end;font-size:12px}
  .solo-body{grid-column:1/-1;grid-row:2;display:block}
  .solo-body strong{color:var(--ink);font-size:14.5px}
  .solo-item{color:var(--muted);font-size:12.5px;display:block;margin-top:1px}

  /* 演出紀錄：依年份分卡、卡內緊湊列 */
  .perf-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:14px;align-items:start;margin-top:14px}
  .perf-card{padding:18px 20px}
  .perf-year{font-family:"Noto Serif TC",serif;font-weight:700;font-size:17px;color:var(--ink);margin:0 0 6px;display:flex;align-items:center;gap:8px}
  .perf-year::before{content:"";width:7px;height:15px;background:var(--gold);border-radius:2px;display:inline-block}
  .perf-list{list-style:none;margin:0;padding:0}
  .perf-row{display:grid;grid-template-columns:3.2rem minmax(0,1fr);gap:10px;align-items:baseline;padding:8px 0;border-bottom:1px solid var(--line-soft)}
  .perf-row:last-child{border-bottom:0;padding-bottom:2px}
  .perf-date{color:var(--brand);font-weight:700;font-size:12.5px}
  .perf-body{display:block}
  .perf-body strong{color:var(--ink);font-size:14.5px;font-weight:600}
  .perf-venue{display:block;font-size:12px;margin-top:2px}
</style>
