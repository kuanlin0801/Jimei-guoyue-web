---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { performances, teamAwards, soloAwardGroups } from '../data/achievements.js';
---
<Layout title="成果與榮譽">
  <section class="page">
    <PageHero eyebrow="榮 耀 時 刻" title="成果與榮譽" sub="集美國小國樂團歷年競賽榮譽與公開演出紀錄。" />

    <section class="ach-block">
      <h2 class="ach-h2 first">競賽榮譽</h2>

      <h3 class="ach-sub">樂團團體獎</h3>
      <ul class="awards">
        {teamAwards.map((a) => (
          <li class="card award">
            <span class={`badge ${a.tier}`}>{a.result}</span>
            <div class="award-body">
              <strong>{a.competition}</strong>
              <span class="meta faint">{a.year}｜{a.item}</span>
            </div>
          </li>
        ))}
      </ul>

      <h3 class="ach-sub">個人獎</h3>
      {soloAwardGroups.map((g) => (
        <div class="solo-group">
          <h4 class="solo-title">{g.group}</h4>
          <ul class="awards">
            {g.awards.map((a) => (
              <li class="card award">
                <span class={`badge ${a.tier}`}>{a.result}</span>
                <div class="award-body">
                  <strong>{a.name}<span class="item">{a.item}</span></strong>
                  <span class="meta faint">{a.year}{a.note ? `・${a.note}` : ''}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="ach-block">
      <h2 class="ach-h2">演出紀錄</h2>
      <ol class="timeline">
        {performances.map((p) => (
          <li class="card ach">
            <span class="ach-year">{p.date}</span>
            <div>
              <strong>{p.title}</strong>
              {p.venue && <p class="faint">{p.venue}{p.note ? `・${p.note}` : ''}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  </section>
</Layout>
<style>
  .ach-block{margin-top:0}
  .ach-h2{font-family:"Noto Serif TC",serif;font-weight:700;font-size:21px;color:#4a3f2a;padding-bottom:9px;border-bottom:2px solid var(--line);margin:34px 0 4px}
  .ach-h2.first{margin-top:6px}
  .ach-sub{font-family:"Noto Sans TC",system-ui,sans-serif;font-weight:700;font-size:15px;color:var(--brand-dark);margin:18px 0 10px}

  .awards{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
  .award{display:grid;grid-template-columns:7.5rem 1fr;gap:14px;align-items:center;padding:13px 18px;box-shadow:0 4px 14px -10px rgba(120,90,40,.4)}
  .award-body{display:flex;flex-direction:column;min-width:0}
  .award-body strong{font-family:"Noto Serif TC",serif;color:var(--ink);font-size:15.5px}
  .award-body .item{color:var(--muted);font-weight:400;margin-left:.5rem;font-size:.9em}
  .award-body .meta{font-size:12.5px;margin-top:2px}

  .badge{justify-self:start;display:inline-flex;align-items:center;justify-content:center;min-width:58px;
    padding:5px 11px;border-radius:999px;font-weight:700;font-size:12.5px;line-height:1.2;text-align:center;white-space:nowrap}
  .badge.gold{background:var(--gold);color:#3a2c08}
  .badge.silver{background:#C9CDD4;color:#2f3338}
  .badge.bronze{background:#D49A63;color:#3a2407}
  .badge.normal{background:#f3ead8;border:1px solid #e3d4b8;color:#8a7c5e}

  .solo-group{margin-bottom:6px}
  .solo-title{font-family:"Noto Sans TC",system-ui,sans-serif;font-weight:700;font-size:14px;color:var(--ink);margin:16px 0 9px;display:flex;align-items:center;gap:8px}
  .solo-title::before{content:"";width:7px;height:15px;background:var(--brand);border-radius:2px;display:inline-block}

  .timeline{list-style:none;margin:14px 0 0;padding:0;display:flex;flex-direction:column;gap:9px}
  .ach{display:grid;grid-template-columns:5.5rem 1fr;gap:14px;align-items:center;padding:12px 18px;box-shadow:0 4px 14px -10px rgba(120,90,40,.4)}
  .ach-year{justify-self:start;background:var(--brand);color:#fff;font-weight:700;border-radius:8px;padding:6px 8px;text-align:center;font-size:12.5px;white-space:nowrap}
  .ach strong{font-family:"Noto Serif TC",serif;color:var(--ink);font-size:15px}
  .ach p{margin:2px 0 0;font-size:12.5px}

  @media(max-width:520px){
    .award{grid-template-columns:5rem 1fr;gap:.65rem}
    .award-body .item{margin-left:0;display:block}
    .ach{grid-template-columns:4.5rem 1fr;gap:.65rem}
    .ach-year{font-size:11.5px;padding:6px 4px}
  }
</style>
