---
import Layout from '../layouts/Layout.astro';
import { calendars } from '../data/calendars.js';
const fbIcon = `<svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z"/></svg>`;
const ytIcon = `<svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path fill="#FF0000" d="M23.5 6.2a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.51A3.02 3.02 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3.02 3.02 0 0 0 2.12 2.14C4.5 20.45 12 20.45 12 20.45s7.5 0 9.38-.51a3.02 3.02 0 0 0 2.12-2.14A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.4 3.6-6.4 3.6Z"/></svg>`;
const lineIcon = `<svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path fill="#06C755" d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>`;
const socials = [
  { href: 'https://www.facebook.com/share/1B4zHMs9uM/', icon: fbIcon, title: 'Facebook', desc: '最新動態、活動花絮、即時通知' },
  { href: 'https://www.youtube.com/channel/UCCKRgFiWspXIBSNgEk283gg', icon: ytIcon, title: 'YouTube', desc: '演出、成果發表與練習影片' },
  { href: 'https://line.me/ti/p/~@616ttxvu', icon: lineIcon, title: 'LINE 官方帳號', desc: '加入好友，接收重要訊息' },
];
---
<Layout>
  <section class="hero">
    <div class="hero-carousel" aria-hidden="true">
      <img class="hero-slide is-active" src="/instruments/erhu_yangqin.webp" alt="" />
      <img class="hero-slide" data-src="/instruments/guzheng.webp" alt="" />
      <img class="hero-slide" data-src="/instruments/pipa_dizi.webp" alt="" />
      <img class="hero-slide" data-src="/instruments/cello.webp" alt="" />
      <img class="hero-slide" data-src="/instruments/sheng.webp" alt="" />
      <img class="hero-slide" data-src="/instruments/zhongruan.webp" alt="" />
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-text">
      <p class="hero-eyebrow">絲 ・ 竹 ・ 和 ・ 鳴</p>
      <h1 class="hero-title">童心<br />奏古音</h1>
      <p class="hero-sub">集美國小國樂團後援會——把每一次練習、演出與相聚，珍貴收藏。</p>
      <div class="hero-cta">
        <a class="btn" href="/summer">暑訓專區</a>
        <a class="btn" href="/duty">值班須知</a>
      </div>
    </div>
  </section>

  <div class="home-cols">
    <section>
      <h2 class="sec-head first"><span class="sec-dot brand"></span>最新公告</h2>
      <div id="home-announcements" class="grid">
        <p class="sr-only">公告載入中</p>
        <article class="card ann-card" aria-hidden="true">
          <span class="skel skel-chip"></span>
          <span class="skel skel-title"></span>
          <span class="skel skel-line"></span>
        </article>
        <article class="card ann-card" aria-hidden="true">
          <span class="skel skel-chip"></span>
          <span class="skel skel-title"></span>
          <span class="skel skel-line short"></span>
        </article>
      </div>
    </section>
    <section class="home-col-side">
      <h2 class="sec-head first"><span class="sec-dot gold"></span>近期行程</h2>
      <div class="card upcoming">
        <ul class="cal-legend">
          {calendars.map((c) => (
            <li><span class="dot" style={{ background: c.color }}></span>{c.name}</li>
          ))}
        </ul>
        <div id="home-events">
          <p class="sr-only">行程載入中</p>
          <div class="skel-row" aria-hidden="true"><span class="skel skel-date"></span><span class="skel skel-flex"></span><span class="skel skel-time"></span></div>
          <div class="skel-row" aria-hidden="true"><span class="skel skel-date"></span><span class="skel skel-flex"></span><span class="skel skel-time"></span></div>
          <div class="skel-row" aria-hidden="true"><span class="skel skel-date"></span><span class="skel skel-flex"></span><span class="skel skel-time"></span></div>
          <div class="skel-row" aria-hidden="true"><span class="skel skel-date"></span><span class="skel skel-flex"></span><span class="skel skel-time"></span></div>
          <div class="skel-row" aria-hidden="true"><span class="skel skel-date"></span><span class="skel skel-flex"></span><span class="skel skel-time"></span></div>
        </div>
        <a class="upcoming-more" href="/calendar">看完整行事曆 →</a>
      </div>
    </section>
  </div>

  <h2 class="sec-head"><span class="sec-dot seal"></span>追蹤我們</h2>
  <div class="grid cols-3 follow-grid">
    {socials.map((s) => (
      <a class="card section-link" href={s.href} target="_blank" rel="noopener noreferrer">
        <span class="section-icon" set:html={s.icon}></span>
        <div><strong>{s.title}</strong><p class="muted">{s.desc}</p></div>
      </a>
    ))}
  </div>
</Layout>
<script>
  import { calendars } from '../data/calendars.js';
  import { fetchUpcoming, toUpcoming, takeNext, formatMonthDay, formatWeekday, formatTime } from '../lib/events.js';
  import { sampleEvents } from '../data/sample-events.js';

  const el = document.getElementById('home-events');
  const esc = (s) => { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; };
  const rowHtml = (ev) =>
    `<div class="ev-row"><div class="ev-date"><div class="md">${esc(formatMonthDay(ev.at))}</div><div class="wd">${esc(formatWeekday(ev.at))}</div></div><span class="ev-dot" style="background:${ev.color}"></span><div class="ev-title">${esc(ev.title)}</div><div class="ev-time">${esc(formatTime(ev))}</div></div>`;

  if (el) {
    const apiKey = import.meta.env.PUBLIC_GOOGLE_API_KEY;
    const now = new Date();
    try {
      let events, isSample = false;
      if (apiKey) {
        events = await fetchUpcoming(calendars, { apiKey, now, count: 5 });
      } else {
        events = takeNext(toUpcoming(sampleEvents(now), now), 5);
        isSample = true;
      }
      el.innerHTML = events.length
        ? events.map(rowHtml).join('') + (isSample ? '<p class="upcoming-sample">（範例資料，設定 API 金鑰後顯示真實行程）</p>' : '')
        : '<p class="muted">近期暫無安排，請見完整行事曆。</p>';
    } catch (e) {
      el.innerHTML = '<p class="muted">行程載入失敗。</p>';
    }
  }
</script>
<script>
  import { fetchAnnouncements, pinnedFirst } from '../lib/announcements.js';
  const el = document.getElementById('home-announcements');
  if (el) {
    const url = import.meta.env.PUBLIC_ANNOUNCEMENTS_CSV || '/sample-announcements.csv';
    const esc = (s) => { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; };
    try {
      const items = pinnedFirst(await fetchAnnouncements(url)).slice(0, 4);
      el.innerHTML = items.length
        ? items.map((a) => `<article class="card ann-card"><div class="ann-meta">${a.pinned ? '<span class="pin">置頂</span>' : ''}<time>${esc(a.date)}</time></div><h3>${esc(a.title)}</h3><p>${esc(a.body)}</p>${a.attachment ? `<p class="att"><a href="${esc(a.attachment.url)}" target="_blank" rel="noopener noreferrer">附件 · ${esc(a.attachment.name)}</a></p>` : ''}</article>`).join('')
        : '<p class="muted">目前沒有公告。</p>';
    } catch (e) {
      el.innerHTML = '<p class="muted">公告載入失敗。</p>';
    }
  }
</script>
<script>
  // Hero instrument carousel: hold each slide, then slowly cross-fade to the next. Loops forever.
  (function () {
    var slides = document.querySelectorAll('.hero-slide');
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (slides.length < 2 || reduce) return;   // reduced motion: keep only the first slide
    // 非第一張進站不載（省流量），輪播要跑了才補 src；第一次淡入前有 6.8s 可載完
    slides.forEach(function (s) {
      var d = s.getAttribute('data-src');
      if (d) s.src = d;
    });
    var idx = 0;
    var HOLD_MS = 6800;
    setInterval(function () {
      slides[idx].classList.remove('is-active');
      idx = (idx + 1) % slides.length;
      slides[idx].classList.add('is-active');
    }, HOLD_MS);
  })();
</script>
<style>
  .hero{position:relative;min-height:472px;display:flex;align-items:center}
  .hero-carousel{position:absolute;inset:0;z-index:0;pointer-events:none}
  .hero-slide{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:contain;object-position:100% 54%;opacity:0;transition:opacity 3s ease-in-out}
  .hero-slide.is-active{opacity:1}
  .hero-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,var(--paper) 15%,rgba(251,246,236,.72) 33%,rgba(251,246,236,0) 55%)}
  .hero-text{position:relative;z-index:2;max-width:52%;padding:26px 0}
  .hero-eyebrow{font-size:12px;letter-spacing:.34em;color:var(--gold);font-weight:700;margin:0 0 20px}
  .hero-title{font-family:"Ma Shan Zheng",cursive;font-weight:400;font-size:clamp(54px,10.5vw,80px);line-height:1.05;color:var(--ink);margin:0;letter-spacing:.05em}
  .hero-sub{margin:24px 0 26px;font-family:"Noto Serif TC",serif;font-size:17px;line-height:1.85;color:var(--muted);max-width:430px}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap}
  .hero-cta .btn{box-shadow:0 8px 18px -8px rgba(31,122,77,.6)}

  .home-cols{display:grid;grid-template-columns:1.6fr 1fr;gap:0 28px;align-items:start}

  .follow-grid{margin-bottom:44px}
  .section-link{display:flex;gap:14px;align-items:center;text-decoration:none;color:inherit;transition:transform .15s,box-shadow .15s}
  .section-link:hover{transform:translateY(-2px);box-shadow:0 8px 22px -12px rgba(120,90,40,.5)}
  .section-icon{display:flex;align-items:center;line-height:1;flex:none}
  .section-icon svg{display:block;width:40px;height:40px}
  .section-link strong{font-family:"Noto Serif TC",serif;color:var(--ink)}
  .section-link p{margin:3px 0 0;font-size:13px}

  @media(max-width:720px){
    .hero{min-height:auto;padding:30px 0 26px}
    .hero-text{max-width:100%}
    /* phones: keep the artwork as a faint backdrop behind the full-width text instead of hiding it */
    .hero-carousel{opacity:.2}
    .hero-scrim{display:none}   /* left-side scrim is desktop-only; unused when text is full width */
    .home-cols{grid-template-columns:1fr}
    .home-col-side .sec-head.first{margin-top:34px}
  }
  @media(prefers-reduced-motion:reduce){
    .hero-slide{transition:none}
  }
</style>
<style is:global>
  /* 近期行程列由 client script 以 innerHTML 注入，需用全域樣式才套得到 */
  .upcoming{padding:18px 22px}
  .upcoming .cal-legend{gap:8px 18px;padding-bottom:12px;margin-bottom:6px;border-bottom:1px solid var(--line-soft)}
  .upcoming .cal-legend li{font-size:12.5px}
  .upcoming .cal-legend .dot{width:10px;height:10px}
  .ev-row{display:flex;align-items:center;gap:14px;padding:11px 0;border-bottom:1px solid var(--line-soft)}
  .ev-date{flex:none;width:42px;text-align:center;line-height:1.15}
  .ev-date .md{font-weight:700;color:var(--ink);font-size:14px}
  .ev-date .wd{font-size:11px;color:var(--faint)}
  .ev-dot{width:9px;height:9px;border-radius:50%;flex:none}
  .ev-title{flex:1;min-width:0;font-size:14.5px;color:#5a4f3a}
  .ev-time{flex:none;font-size:12.5px;color:var(--faint)}
  .upcoming-more{display:inline-block;margin-top:13px;font-size:13px;color:var(--brand);text-decoration:none;font-weight:600}
  .upcoming-more:hover{text-decoration:underline}
  .upcoming-sample{font-size:.75rem;color:var(--faint);margin:.6rem 0 0}
</style>
