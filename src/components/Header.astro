---
const nav = [
  { href: '/', label: '首頁' },
  { href: '/calendar', label: '行事曆' },
  { href: '/announcements', label: '最新公告' },
  { href: '/support', label: '活動支援' },
  { href: '/documents', label: '文件下載' },
  { href: '/gallery', label: '活動相簿' },
  { href: '/achievements', label: '成果' },
  { href: '/about', label: '關於我們' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/logo.png" alt="集美國小國樂團" class="brand-logo" />
      <span class="brand-name">集美國小國樂團</span>
    </a>
    <nav>
      {nav.map((n) => (
        <a href={n.href} class={path === n.href ? 'active' : ''}>{n.label}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  .site-header{background:var(--paper-card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:1000;box-shadow:0 1px 6px rgba(0,0,0,.06)}
  .header-inner{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding-top:.5rem;padding-bottom:.5rem}
  .brand{display:flex;align-items:center;gap:.55rem;text-decoration:none;color:var(--ink)}
  .brand-logo{height:44px;width:auto;display:block}
  .brand-name{font-weight:700;font-size:1.1rem}
  nav{display:flex;gap:1.1rem;flex-wrap:wrap}
  nav a{color:var(--ink);text-decoration:none;opacity:.85;padding:.15rem 0;border-bottom:2px solid transparent}
  nav a:hover,nav a.active{opacity:1;color:var(--brand);border-bottom-color:var(--brand)}
</style>
