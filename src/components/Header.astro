---
const nav = [
  { href: '/', label: '首頁' },
  { href: '/announcements', label: '公告' },
  { href: '/calendar', label: '行事曆' },
  { href: '/support', label: '活動支援' },
  { href: '/documents', label: '文件下載' },
  { href: '/achievements', label: '成果' },
  { href: '/about', label: '關於我們' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/logo.png" alt="集美國小國樂團" class="brand-logo" />
      <span class="brand-text">
        <span class="brand-name">集美國小國樂團</span>
        <span class="brand-en">JIMEI CHINESE ORCHESTRA</span>
      </span>
    </a>
    <button class="nav-toggle" type="button" aria-label="選單" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span>
    </button>
    <nav id="site-nav">
      {nav.map((n) => (
        <a href={n.href} class={path === n.href ? 'active' : ''}>{n.label}</a>
      ))}
    </nav>
  </div>
</header>
<style>
  .site-header{position:sticky;top:0;z-index:1000;background:rgba(251,246,236,.88);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  .header-inner{position:relative;display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap;padding-top:13px;padding-bottom:13px}
  .brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}
  .brand-logo{height:40px;width:auto;display:block}
  .brand-text{display:block;line-height:1.05}
  .brand-name{display:block;font-family:"Noto Serif TC",serif;font-weight:700;font-size:16px;color:var(--ink)}
  .brand-en{display:block;font-size:9.5px;letter-spacing:.16em;color:#b9a87f;font-weight:600}

  nav{display:flex;gap:5px;flex-wrap:wrap;align-items:center}
  nav a{color:#5a4f3a;text-decoration:none;font-weight:500;font-size:14px;padding:7px 12px;border-radius:999px}
  nav a:hover{color:var(--brand)}
  nav a.active{color:var(--brand);font-weight:700;background:#fff;padding:7px 14px;box-shadow:0 2px 8px -4px rgba(120,90,40,.45)}

  .nav-toggle{display:none;flex-direction:column;justify-content:center;gap:5px;width:26px;height:32px;padding:0;border:0;background:none;cursor:pointer}
  .nav-toggle span{display:block;height:2px;width:100%;background:var(--brand);border-radius:2px}

  @media(max-width:720px){
    .nav-toggle{display:flex}
    .brand-en{display:none}
    .brand-logo{height:34px}
    .brand-name{font-size:15px}
    #site-nav{display:none;position:absolute;left:0;right:0;top:100%;flex-direction:column;gap:2px;background:#fff;border-bottom:1px solid var(--line);box-shadow:0 12px 24px -16px rgba(120,90,40,.5);padding:8px 12px}
    .site-header.nav-open #site-nav{display:flex}
    #site-nav a{display:block;font-size:15px;padding:11px 16px;border-radius:11px}
    #site-nav a.active{background:var(--chip);box-shadow:none}
  }
</style>
<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.nav-toggle');
  toggle?.addEventListener('click', () => {
    const open = header.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
