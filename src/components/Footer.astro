---
const club = {
  name: '集美國小國樂團',
  contact: '黃子玉 0968230563',
  lineQr: '/line-qr.jpg',
};
---
<footer class="site-footer">
  <div class="container">
    <strong>{club.name}</strong>
    <p>聯絡：{club.contact}</p>
    <figure class="line-qr">
      <img src={club.lineQr} alt="集美國小國樂團 LINE QR code" width="128" height="128" loading="lazy" />
      <figcaption class="muted">掃描 QR 加入 LINE</figcaption>
    </figure>
  </div>
</footer>
<style>
  .site-footer{background:var(--ink);color:#d8d2c4;font-size:.9rem;padding:1.4rem 0;margin-top:1.5rem}
  .site-footer a{color:var(--gold)}
  .site-footer p{margin:.15rem 0}
  .line-qr{margin:.7rem 0 0;display:flex;flex-direction:column;gap:.35rem;align-items:flex-start}
  .line-qr img{width:128px;height:128px;border-radius:8px;background:#fff;padding:6px;display:block}
  .line-qr figcaption{font-size:.82rem}
</style>
